#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#ifndef USE_DVORAK_AS_DEFAULT
#define USE_DVORAK_AS_DEFAULT 1
#endif

/ {
    behaviors {
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // Alt + ` macro for Japanese IME switching on Windows
        alt_grav_macro: alt_grav_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LALT>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

#if USE_DVORAK_AS_DEFAULT
        // ==========================================
        // Layer 0: Default (Dvorak)
        // ==========================================
        default_layer {
            display-name = "Dvorak";
            bindings = <
&mt LGUI ESC   &kp SQT        &kp COMMA  &lt 4 DOT           &kp P            &kp Y       &kp F            &kp G     &kp C                &kp R  &kp L      &kp SLASH
&mt LCTRL TAB  &kp A          &kp O      &mt LEFT_CONTROL E  &kp U            &kp I       &kp D            &kp H     &mt RIGHT_CONTROL T  &kp N  &kp S      &kp MINUS
&kp LSHFT      &kp SEMICOLON  &kp Q      &kp J               &kp K            &kp X       &kp B            &kp M     &kp W                &kp V  &kp Z      &kp RSHIFT
                                         &mt LALT BSPC       &mo 1            &mt LSHIFT SPACE  &mt RCTRL ENTER  &mo 2     &mt LALT TAB
            >;
        };
#else
        // ==========================================
        // Layer 0: Default (Qwerty)
        // ==========================================
        default_layer {
            display-name = "Qwerty";
            bindings = <
&mt LGUI ESC   &kp Q          &kp W      &kp E               &kp R            &kp T       &kp Y            &kp U     &kp I                &kp O      &kp P      &kp LBKT
&mt LCTRL TAB  &kp A          &kp S      &mt LEFT_CONTROL D  &kp F            &kp G       &kp H            &kp J     &mt RIGHT_CONTROL K  &kp L      &kp SEMI   &kp SQT
&kp LSHFT      &kp Z          &kp X      &kp C               &kp V            &kp B       &kp N            &kp M     &kp COMMA            &lt 4 DOT  &kp SLASH  &kp RSHIFT
                                         &mt LALT BSPC       &mo 1            &mt LSHIFT SPACE  &mt RCTRL ENTER  &mo 2     &mt LALT TAB
            >;
        };
#endif

        // ==========================================
        // Layer 1: Lower (Function & Navigation & IME)
        // ==========================================
        lower_layer {
            display-name = "Lower";
            bindings = <
&trans  &kp F1        &kp F2   &kp F3               &kp F4    &kp F5     &none            &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans
&trans  &kp F6        &kp F7   &mt LEFT_CONTROL F8  &kp F9    &kp F10    &alt_grav_macro  &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &trans
&trans  &kp F11       &kp F12  &kp PSCRN            &kp SLCK  &kp INS    &none            &none     &none          &none        &none      &trans
                               &mt LALT DEL         &trans    &trans     &trans           &trans    &trans
            >;
        };

        // ==========================================
        // Layer 2: Raise (Numbers & Symbols)
        // ==========================================
        raise_layer {
            display-name = "Raise";
            bindings = <
&trans  &kp N1  &kp N2  &kp N3   &kp N4  &kp N5     &kp N6     &kp N7    &kp N8     &kp N9     &kp N0     &trans
&trans  &none   &none   &kp ESC  &none   &kp TAB    &kp LBKT   &kp RBKT  &kp SLASH  &kp EQUAL  &kp MINUS  &trans
&trans  &none   &none   &none    &none   &none      &kp GRAVE  &kp BSLH  &none      &none      &none      &trans
                        &trans   &trans  &trans     &trans     &trans    &trans
            >;
        };

        // ==========================================
        // Layer 3: Adjust (BLE, System & Unlock)
        // ==========================================
        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4  &bt BT_SEL 5      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 5
&studio_unlock  &sys_reset    &bootloader   &bt BT_CLR_ALL  &bt BT_CLR    &trans            &trans        &bt BT_CLR    &bt BT_CLR_ALL  &bootloader   &sys_reset    &studio_unlock
&none           &none         &none         &none           &none         &none             &none         &none         &none           &none         &none         &none
                                            &trans          &trans        &trans            &trans        &trans        &trans
            >;
        };

        // ==========================================
        // Layer 4: Mouse (Triggered by holding '.')
        // ==========================================
        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &mkp MB2  &trans  &mkp MB1   &trans       &trans     &trans          &msc SCRL_DOWN  &msc SCRL_UP  &trans           &trans
&trans  &trans  &mkp MB2  &trans  &mkp MB1   &mkp MCLK    &trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans  &trans    &trans  &trans     &trans       &mkp LCLK  &mkp MCLK       &mkp RCLK       &trans        &trans           &trans
                          &trans  &trans     &trans       &mkp LCLK  &mkp RCLK       &trans
            >;
        };

        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };
    };
};
